# ==============================================================================
# PS4 (DualShock 4) / PS5 (DualSense) gamepad - LinuxCNC 2.8/2.9 jogging
# Layout 2026-10-03 (Marios), revision 2:
#   L1 (hold)            jog enable (deadman) - nothing moves without it
#   R1 (hold)            FAST jog speed
#   Left stick  <->      Z
#   Right stick up/dn    X  (down = +X, away from the switch)
#   L2 / R2 triggers     C +  /  C -   (analog: press further = faster)
#   L1 + Share           HOME ALL
#   L1 + D-pad DOWN      TOUCH OFF Z: current position becomes work Z0
#                        (runs [HALUI] MDI_COMMAND = G10 L20 P0 Z0 from the INI)
#   Cross / Circle       machine on / off
#   Triangle / Square    router start / stop
#   Options / PS         E-stop / E-stop reset
#
# Loaded by the INI as the LAST "HALFILE = gamepad.hal". The main .hal must
# stay as it is: it creates the jog signals used here. Jogging needs Home All.
# ==============================================================================

loadrt deadzone names=joy_dz_z,joy_dz_x
loadrt scale    names=joy_z,joy_x
loadrt limit1   names=joy_r2,joy_l2
loadrt sum2     names=joy_c
loadrt mux2     names=joy_dm_x,joy_dm_z,joy_dm_c,joy_speed
loadrt and2     names=joy_home_ok,joy_touch_ok
loadrt comp     names=joy_dpad_dn
addf joy_dz_z     servo-thread
addf joy_dz_x     servo-thread
addf joy_z        servo-thread
addf joy_x        servo-thread
addf joy_r2       servo-thread
addf joy_l2       servo-thread
addf joy_c        servo-thread
addf joy_dm_x     servo-thread
addf joy_dm_z     servo-thread
addf joy_dm_c     servo-thread
addf joy_speed    servo-thread
addf joy_home_ok  servo-thread
addf joy_touch_ok servo-thread
addf joy_dpad_dn  servo-thread

# Gamepad (USB). Pins appear as input.0.*  ("...-position" = -1..+1).
loadusr -W hal_input -KRAL /dev/input/by-id/usb-Sony_Interactive_Entertainment_Wireless_Controller-if03-event-joystick

# ------------------------------------------------------------------------------
# JOG SPEED, per minute (mm/min X/Z, deg/min C): normal / with R1 held.
# LinuxCNC still caps each axis at its INI MAX_VELOCITY.
# ------------------------------------------------------------------------------
setp joy_speed.in0 400
setp joy_speed.in1 1000
net joy-fast input.0.btn-tr => joy_speed.sel
net jog-speed <= joy_speed.out

# ------------------------------------------------------------------------------
# DEAD ZONE (sticks). CHANGED 2026-10-04: X ignores +-0.45 and Z +-0.35
# around centre (both were +-0.30) because the X stick drifts.
# The deadzone component's "threshold" is the FULL width, so 0.90 = +-0.45.
# It also shifts the output so movement starts smoothly from 0, but then a
# full stick gives only 0.70; the scale gain 1/0.70 = 1.428571 restores full
# speed at full stick. To change the zone to +-Z: threshold = 2*Z and
# gain = 1/(1-Z)  (e.g. +-0.40: threshold 0.80, gain 1.666667).
# halui's own deadband is lowered to 0.05 so the two do not add up.
# ------------------------------------------------------------------------------
setp joy_dz_z.center 0.0
setp joy_dz_z.threshold 0.70
setp joy_dz_x.center 0.0
setp joy_dz_x.threshold 0.90
setp halui.axis.jog-deadband 0.05

# ------------------------------------------------------------------------------
# DEADMAN: L1 must be held; released = every axis command 0 (halui stops).
# ------------------------------------------------------------------------------
net joy-deadman input.0.btn-tl => joy_dm_x.sel joy_dm_z.sel joy_dm_c.sel joy_home_ok.in0 joy_touch_ok.in0
setp joy_dm_x.in0 0.0
setp joy_dm_z.in0 0.0
setp joy_dm_c.in0 0.0

# --- Z : LEFT stick, left/right. Right = +Z (away from the chuck). ------------
setp joy_z.gain 1.538462     # = 1/(1-0.35): full stick = full speed
net joy-z-raw input.0.abs-x-position => joy_dz_z.in
net joy-z-dz  joy_dz_z.out           => joy_z.in
net joy-z-dir joy_z.out              => joy_dm_z.in1
net jog-z-analog <= joy_dm_z.out

# --- X : RIGHT stick, up/down. CHANGED 2026-10-04: DOWN = +X (larger radius,
#         away from the X switch), the same as the DOWN arrow key and the "+"
#         button in AXIS. Linux reports DOWN as +1, so the gain is positive.
setp joy_x.gain 1.818182     # = 1/(1-0.45): full stick = full speed, DOWN = +X
net joy-x-raw input.0.abs-ry-position => joy_dz_x.in
net joy-x-dz  joy_dz_x.out            => joy_x.in
net joy-x-dir joy_x.out               => joy_dm_x.in1
net jog-x-analog <= joy_dm_x.out

# --- C : L2 = C+, R2 = C-  (swapped 2026-10-03, revision 2) -------------------
# A trigger reads -1 released and +1 fully pressed (R2 = abs-rz, L2 = abs-z).
# hal_input may report 0 instead of -1 until a trigger is first moved; each
# trigger is limited to 0..1 so both "released" and that false 0 give 0.
setp joy_r2.min 0.0
setp joy_r2.max 1.0
setp joy_l2.min 0.0
setp joy_l2.max 1.0
net joy-r2 input.0.abs-rz-position => joy_r2.in
net joy-l2 input.0.abs-z-position  => joy_l2.in
net joy-r2-lim joy_r2.out => joy_c.in0
net joy-l2-lim joy_l2.out => joy_c.in1
# CHANGED 2026-10-04: x6. halui has ONE jog speed for all axes (mm/min for
# X/Z, deg/min for C), so 400/1000 alone gave C only 6.7/16.7 deg/s.
# With x6: normal 40 deg/s, R1 100 deg/s. LinuxCNC still caps C at its
# [AXIS_C] MAX_VELOCITY (checked in source: emcJogCont and motion clamp it).
setp joy_c.gain0 -6.0
setp joy_c.gain1  6.0
net joy-c-dir joy_c.out => joy_dm_c.in1
net jog-c-analog <= joy_dm_c.out

# ------------------------------------------------------------------------------
# HOME ALL = L1 + Share. Guarded by L1 so a stray press does not home (homing
# moves every axis). Works only with the machine ON and no program running.
# ------------------------------------------------------------------------------
net joy-share input.0.btn-select => joy_home_ok.in1
net joy-home  joy_home_ok.out    => halui.home-all

# ------------------------------------------------------------------------------
# TOUCH OFF Z = L1 + D-pad DOWN -> [HALUI] MDI_COMMAND 1 = G10 L20 P0 Z0
# (current tool tip becomes Z0 of the ACTIVE work offset). halui returns to
# the previous mode afterwards, so jogging keeps working.
# The D-pad is an axis (hat): DOWN = +1, so "down pressed" = value > 0.5.
# NEVER touch off X on this machine: work X0 must stay the chuck centre.
# ------------------------------------------------------------------------------
setp joy_dpad_dn.in0 0.5
net joy-dpad-y input.0.abs-hat0y-position => joy_dpad_dn.in1
net joy-dpad-dn joy_dpad_dn.out => joy_touch_ok.in1
net joy-touch-z joy_touch_ok.out => halui.mdi-command-00

# ------------------------------------------------------------------------------
# MACHINE POWER / E-STOP  (Linux gamepad standard: btn-a Cross, btn-b Circle,
# btn-x Triangle, btn-y Square, btn-start Options, btn-mode PS, btn-select Share)
# ------------------------------------------------------------------------------
net joy-machine-on  input.0.btn-a     => halui.machine.on
net joy-machine-off input.0.btn-b     => halui.machine.off
net joy-estop       input.0.btn-start => halui.estop.activate
net joy-estop-reset input.0.btn-mode  => halui.estop.reset

# --- ROUTER (main .hal already puts halui's spindle pins on these signals) ----
net spindle-manual-cw   <= input.0.btn-x      # Triangle = start
net spindle-manual-stop <= input.0.btn-y      # Square   = stop

# ------------------------------------------------------------------------------
# OPTIONAL - jogging BEFORE Home All (joint mode). No soft limits without
# homing: low speed only. Remove the # from the five lines to enable.
# ------------------------------------------------------------------------------
# setp halui.joint.jog-deadband 0.05
# net jog-speed    => halui.joint.jog-speed
# net jog-x-analog => halui.joint.0.analog
# net jog-z-analog => halui.joint.1.analog
# net jog-c-analog => halui.joint.2.analog
